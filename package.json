{
  "name": "beebots",
  "version": "2026.10.14",
  "private": true,
  "description": "Three AI trading bees on OKX EEA X-Perps, picked by Gemini 4 Argon or Jev with a code fallback",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": []
  },
  "scripts": {
    "dev": "PAPER_CONTAINER_BIND=false tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "universe": "tsx src/tools/universe.ts",
    "snapshot": "tsx src/tools/snapshot.ts",
    "parity": "tsx src/tools/parity-market.ts",
    "e2e:fake-jev": "tsx test/e2e-dry.harness.ts",
    "effective-config": "tsx src/tools/effective-config.ts",
    "owner:bees": "tsx src/tools/owner-bees.ts",
    "demo:roundtrip": "tsx --env-file-if-exists=.env src/tools/demo-roundtrip.ts",
    "demo:close": "tsx --env-file-if-exists=.env src/tools/demo-close.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
