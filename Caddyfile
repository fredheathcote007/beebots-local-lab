# BeeBots paper-only LAN: accept direct socket peers from the approved /24 only.
# Do not trust X-Forwarded-For or Docker bridge gateways; those can hide the real source.
:80 {
	@denied not remote_ip 10.1.1.0/24
	handle @denied {
		respond "Forbidden" 403
	}

	handle {
		encode zstd gzip

		# Read-only engine endpoints. Only GET is proxied; no forwarded client address is trusted.
		@api {
			method GET
			path /events /snapshot /history /equity /visit /health /profile /bee-image/* /setup/status /hive/status /keeper/scorecard
		}
		handle @api {
			reverse_proxy engine:8080 {
				# Server-sent events: never buffer.
				flush_interval -1
			}
		}

		# Static dashboard, built into the image. Hashed assets are immutable; index.html revalidates.
		handle {
			root * /srv/dashboard
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}

		header {
			-Server
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
			Referrer-Policy strict-origin-when-cross-origin
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		}
	}
}
