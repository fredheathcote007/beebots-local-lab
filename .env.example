# Optional local paper-lab tuning. No credentials or webhook URLs belong here.
# MODE and DRY_RUN are fixed by Compose; the engine rejects demo/live intent and all broker credentials.
# Compose pins BEE_PROFILES_PATH=/data/bee-profiles.json in the same bees-data volume as DB_PATH.
# Run the owner CLI with `docker compose exec -T engine node dist/tools/owner-bees.js --file /data/bee-profiles.json ...`.

# How often the paper strategies evaluate (milliseconds).
TICK_MS=10000
DATA_REFRESH_MS=60000

# Starting simulated balance per bee and public crypto-market volume floor.
BEE_START_EQUITY_USD=333
MIN_24H_VOL_USD=1000000
ALLOW_NON_CRYPTO=false

# Optional Decider observer; disabled by default. Container opt-in uses docker-compose.shadow.yml.
# Endpoint (127.0.0.1:18009), model (decider-4b-v2.1), and Unix socket path are pinned in code.
LOCAL_SHADOW_ENABLED=false
LOCAL_SHADOW_MODEL=decider-4b-v2.1
LOCAL_SHADOW_TRANSPORT=host-loopback

# Simulated execution and hard risk limits.
TAKER_FEE_RATE=0.0005
MAX_LEVERAGE=2
MAX_NOTIONAL_USD_PER_BEE=700
DAILY_LOSS_STOP_PCT=8
BEE_RETIRE_AT_PCT=40

# Optional published port for the LAN dashboard (host IP fixed to 10.1.1.40).
LAN_DASHBOARD_PORT=8080
